# ── Python 产物 ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# ── 工具缓存 ────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.import_linter_cache/
*.orig

# ── 运行产物（录像 / 存档 · ADR-074 的默认落盘目录）────────────────
# 落盘目录在**项目优先**的位置；不可写时程序会回落到 `~/.tetris/`，
# 那份在仓库外，git 不管。
.tetris-data/

# ── 测试与覆盖率产物 ─────────────────────────────────────────────
.coverage
coverage.xml
htmlcov/

# ── 编辑器本地状态 ───────────────────────────────────────────────
.vscode/
.idea/

# ── 本地私有配置（可能含 API key）─────────────────────────────────
.env
.env.*
